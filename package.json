{
  "name": "tudruj-home-assistant",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "start": "npm run prisma:generate && ts-node -r tsconfig-paths/register src/index.ts",
    "docker:up": "docker compose up -d --build",
    "docker:rebuild": "docker compose down -v && docker compose build --no-cache && docker compose up -d",
    "docker:clean": "docker compose down -v --rmi all --remove-orphans"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "6.9.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "axios": "^1.13.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "mime": "^4.1.0",
    "mqtt": "^5.10.1",
    "multer": "^2.0.2",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "webdav": "^5.9.0"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/mime": "^3.0.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.9.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "6.9.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
