{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],

    "paths": {
      "@modules/*": ["./src/modules/*"]
    }
  },
  "include": [
    "src",
    "src/types/**/*.d.ts"
  ]
}
